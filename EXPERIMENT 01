def solve(board, row):
    if row == 8:
        print_board(board)
        return True

    for col in range(8):
        if safe(board, row, col):
            board[row] = col
            if solve(board, row + 1):
                return True
            board[row] = -1

    return False


def safe(board, row, col):
    for i in range(row):
        if board[i] == col or abs(board[i] - col) == abs(i - row):
            return False
    return True


def print_board(board):
    for i in range(8):
        for j in range(8):
            if board[i] == j:
                print("Q", end=" ")
            else:
                print(".", end=" ")
        print()


board = [-1] * 8

if not solve(board, 0):
    print("No solution")
